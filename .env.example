APP_NAME=FIESC Predictive Maintenance API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fiesc
AUTO_MIGRATE_ON_STARTUP=true

CORS_ORIGINS=http://localhost:5173
SIMILARITY_K=10

STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_DOCUMENTS_BUCKET=fiesc
S3_ARTIFACTS_BUCKET=fiesc-analysis-artifacts
S3_PRESIGNED_EXPIRY_SECONDS=3600
MINIO_CONSOLE_URL=http://localhost:9001

LLM_PROVIDER=
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com

MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.txt,.md,.docx
